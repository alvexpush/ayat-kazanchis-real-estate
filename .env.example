# Runtime
NODE_ENV=production
PORT=3000
APP_URL=https://ayatkazanchisrealestate.online
DATABASE_PATH=data/platform.sqlite

# Authentication (generate long random values; never commit the real values)
OTP_SECRET=generate_a_long_random_secret
ADMIN_EMAIL=admin@ayatkazanchisrealestate.online
ADMIN_PASSWORD=change_to_a_long_unique_password
AUTH_LOGIN_CODE_REQUIRED=true

# Crypto deposit wallets (server-side only)
BTC_DEPOSIT_ADDRESS=your_bitcoin_address
USDT_DEPOSIT_ADDRESS=your_usdt_address
USDT_DEPOSIT_NETWORK=TRON (TRC-20)

# Email: choose zoho or resend
EMAIL_PROVIDER=zoho
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token
ZOHO_FROM_EMAIL=noreply@ayatkazanchisrealestate.online
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_MAIL_API_URL=https://mail.zoho.com/api
# ZOHO_ACCOUNT_ID is optional

# Alternative email provider
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=your_resend_api_key
# AUTH_FROM_EMAIL=Ayat Kazanchis Real Estate <noreply@ayatkazanchisrealestate.online>

# Optional market data
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
